{
  "manifest_version": 3,
  "name": "La Rambla Cleaner",
  "description": "Hide ignored users and filter discussion categories on fcbarca.com.",
  "version": "2.4.9",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://www.fcbarca.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://*.cloudfunctions.net/*",
    "https://firestore.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/barcelona-16.png",
      "32": "icons/barcelona-32.png",
      "48": "icons/barcelona-48.png",
      "128": "icons/barcelona-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.fcbarca.com/*"
      ],
      "js": [
        "src/keyword-cache.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "src/content.css"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "larambla-cleaner@example.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "background": {
    "scripts": [
      "src/translation-config.js",
      "src/keyword-cache.js",
      "src/background.js"
    ]
  },
  "icons": {
    "16": "icons/barcelona-16.png",
    "32": "icons/barcelona-32.png",
    "48": "icons/barcelona-48.png",
    "128": "icons/barcelona-128.png"
  }
}
