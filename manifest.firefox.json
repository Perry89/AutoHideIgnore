{
  "manifest_version": 3,
  "name": "La Rambla Cleaner",
  "description": "Hide ignored users and filter discussion categories on fcbarca.com.",
  "version": "2.4.3",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://www.fcbarca.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://*.cloudfunctions.net/*"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.fcbarca.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "larambla-cleaner@example.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "background": {
    "scripts": [
      "src/translation-config.js",
      "src/background.js"
    ]
  }
}
