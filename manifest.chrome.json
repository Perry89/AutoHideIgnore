{
  "manifest_version": 3,
  "name": "La Rambla Cleaner",
  "description": "Hide ignored users and filter discussion categories on fcbarca.com.",
  "version": "2.4.2",
  "minimum_chrome_version": "88",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://www.fcbarca.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://*.cloudfunctions.net/*"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.fcbarca.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  }
}
