{
  "manifest_version": 3,
  "name": "La Rambla Cleaner",
  "version": "1.2",

"permissions": ["storage", "activeTab"],
  "host_permissions": ["*://www.fcbarca.com/*"],

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["*://www.fcbarca.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "larambla-cleaner@example.com",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  }
}