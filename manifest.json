{
  "manifest_version": 3,
  "name": "La Rambla Cleaner",
  "description": "Hide ignored users and filter discussion categories on fcbarca.com.",
  "version": "2.4.6",
  "minimum_chrome_version": "88",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://www.fcbarca.com/*",
    "https://identitytoolkit.googleapis.com/*",
    "https://*.cloudfunctions.net/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/barcelona-16.png",
      "32": "icons/barcelona-32.png",
      "48": "icons/barcelona-48.png",
      "128": "icons/barcelona-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.fcbarca.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "src/content.css"
      ]
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "icons/barcelona-16.png",
    "32": "icons/barcelona-32.png",
    "48": "icons/barcelona-48.png",
    "128": "icons/barcelona-128.png"
  }
}
