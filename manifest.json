{
  "manifest_version": 3,
  "name": "La Rambla Cleaner",
  "description": "Hide ignored users and filter discussion categories on fcbarca.com.",
  "version": "2.2.0",
  "minimum_chrome_version": "88",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["*://www.fcbarca.com/*"],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://www.fcbarca.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
