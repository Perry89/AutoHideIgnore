{
  "manifest_version": 3,
  "name": "La Rambla Cleaner",
  "version": "2.1",

"permissions": ["storage", "activeTab"],
  "host_permissions": ["*://www.fcbarca.com/*"],

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["*://www.fcbarca.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}